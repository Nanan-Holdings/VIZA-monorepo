# viza-be/submission-service — environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Supabase (postgres + storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (failure alerts)
RESEND_API_KEY=re_your_resend_api_key

# 2captcha — solves the CEAC start-page image CAPTCHA (US-021–US-026).
# Get a key at https://2captcha.com/enterpage. Credit-based billing.
TWOCAPTCHA_API_KEY=your-2captcha-api-key

# Bright Data residential proxy — required for UKVI and other geo-gated portals.
# From the Bright Data zone dashboard (Proxy → Residential → your zone):
#   Host: brd.superproxy.io
#   Port: 22225 or 33335 (zone-specific)
# Option A — paste the full zone username + password:
BRIGHTDATA_PROXY_HOST=brd.superproxy.io
BRIGHTDATA_PROXY_PORT=33335
BRIGHTDATA_USERNAME=brd-customer-<customer_id>-zone-<zone_name>
BRIGHTDATA_PASSWORD=<zone_password>
# Option B — build the username from customer id + zone name:
# BRIGHTDATA_CUSTOMER_ID=<customer_id>
# BRIGHTDATA_ZONE=<zone_name>
# BRIGHTDATA_ZONE_PASSWORD=<zone_password>
# BRIGHTDATA_API / BRIGHTDATA_API_TOKEN are usage-API tokens — NOT the proxy password.
BRIGHTDATA_ZONE=
# UK Standard Visitor — default local IP (same as France). Set UK_USE_LOCAL_IP=false
# to egress via Bright Data GB residential proxy instead.
UK_USE_LOCAL_IP=true
UK_PROXY_COUNTRY=gb
# Set to 1 to create a real UKVI saved-application account on registration submit.
UK_REGISTER_COMMIT=0

# Submission mode defaults
VIZA_SUBMISSION_DRY_RUN=1
SUBMISSION_RESULT_SECRET_KEY=replace-with-at-least-16-random-chars
# Local legacy submission_queue runner concurrency. The current single-runner
# maximum is 10; set to 1 to force old serial behavior for diagnostics.
SUBMISSION_SERVICE_MAX_CONCURRENCY=10
# Multi-runner submission_queue leases. Apply agent-backend migration 0105
# before horizontally scaling submission-service instances.
SUBMISSION_SERVICE_WORKER_ID=
SUBMISSION_SERVICE_QUEUE_LEASE_SECONDS=900
# Cloud worker topology: country-scoped workers may set RUNNER_JOB_COUNTRY;
# the shared pool leaves it empty. Dedicated workers disable legacy polling.
SUBMISSION_SERVICE_LEGACY_QUEUE_ENABLED=true
SUBMISSION_SERVICE_INDONESIA_QUEUE_ENABLED=false
SUBMISSION_SERVICE_RUNNER_JOB_CONSUMER_ENABLED=true
RUNNER_MACHINE_KIND=
RUNNER_JOB_COUNTRY=
# Optional single-job runner_job guard. For approved Taiwan smoke runs, set
# RUNNER_JOB_COUNTRY=taiwan and the exact target runner_job.id; the worker
# verifies country + optional application id before claiming and exits after
# one job.
RUNNER_JOB_TARGET_ID=
RUNNER_JOB_EXPECTED_APPLICATION_ID=

# France / Schengen live-assisted mode. Keep dry-run as the default unless you
# are intentionally running a visible, applicant-controlled France-Visas assist.
FRANCE_SUBMISSION_MODE=dry_run
FRANCE_LIVE_SUBMISSION_ENABLED=false
FRANCE_LIVE_ASSISTED_ONLY=true
FRANCE_REQUIRE_FINAL_USER_CONFIRMATION=true
FRANCE_REQUIRE_OFFICIAL_REVIEW_DIFF_PASS=true
FRANCE_PLAYWRIGHT_HEADLESS=false
FRANCE_CAPTURE_TRACE=true
FRANCE_CAPTURE_SCREENSHOT=true
FRANCE_LIVE_MAX_DURATION_SECONDS=1800
FRANCE_OFFICIAL_BASE_URL=https://application-form.france-visas.gouv.fr/
FRANCE_PAYMENT_LIVE_ENABLED=false
FRANCE_APPOINTMENT_LIVE_ENABLED=false
# Optional France-Visas account registration. This uses a VIZA catch-all alias
# (`appl-*.viza.it.com`) and 2captcha only for the registration image CAPTCHA.
# Login risk checks, Cloudflare/anti-bot gates, final validation, payment, and
# appointment booking remain manual.
FRANCE_ACCOUNT_REGISTRATION_ENABLED=false
FRANCE_REGISTRATION_2CAPTCHA_ENABLED=false
FRANCE_REGISTRATION_MAX_CAPTCHA_ATTEMPTS=3
FRANCE_REGISTRATION_EMAIL_TIMEOUT_MS=180000

# U.S. B1/B2 appointment / China USVisaScheduling runner. Keep disabled until
# a live smoke has a valid official session/account context and operator
# approval for the test account.
US_APPOINTMENT_ASSISTED_LIVE_ENABLED=false
US_APPOINTMENT_PROVIDER_ALLOWLIST=usvisascheduling
US_APPOINTMENT_SUPPORTED_COUNTRIES=CN
US_APPOINTMENT_RUNNER_BATCH_SIZE=3
US_APPOINTMENT_SLOT_CHECK_COOLDOWN_MS=600000
US_APPOINTMENT_BASE_URL=https://www.usvisascheduling.com/
US_APPOINTMENT_PLAYWRIGHT_ENABLED=false
US_APPOINTMENT_PLAYWRIGHT_HEADLESS=false
US_APPOINTMENT_PLAYWRIGHT_CHANNEL=chrome
# Optional: connect runner to a user-launched real Chrome with CDP.
# Start locally with: powershell -ExecutionPolicy Bypass -File scripts/start-us-appointment-user-chrome.ps1
US_APPOINTMENT_CDP_ENDPOINT=
# Optional: Bright Data Browser API endpoint. Use Browser API zone credentials,
# not a proxy/unlocker zone. Example:
# wss://<BROWSER_API_USER>:<BROWSER_API_PASSWORD>@brd.superproxy.io:9222
BRIGHTDATA_BROWSER_API_ENDPOINT=
BRIGHTDATA_BROWSER_WS=
SBR_WS_ENDPOINT=
# France-Visas and mainland-China TLScontact are Browserbase-only. They ignore
# all country/global CDP and Bright Data endpoint variables and fail closed if
# Browserbase is explicitly disabled or BROWSERBASE_API_KEY is unavailable.
US_APPOINTMENT_STORAGE_STATE_PATH=output/playwright/usvisascheduling-storage-state.json
US_APPOINTMENT_CAPTCHA_SOLVING_ENABLED=false
US_APPOINTMENT_CAPTCHA_MAX_ATTEMPTS=2

# Arrival-card official portal browser endpoints. Leave blank to use local
# Playwright Chromium. Set a country-specific endpoint when a government portal
# blocks the local runner network but works through an authorized Browser API
# zone.
MDAC_BROWSER_API_ENDPOINT=
# Fly production: store this as a protected GitHub environment secret. The
# deployment workflow copies it to Fly Secrets; never add it to a Fly TOML or
# commit a Browser API/CDP URL because it contains provider credentials.
MDAC_BRIGHTDATA_BROWSER_API_ENDPOINT=
TDAC_BROWSER_API_ENDPOINT=
SGAC_BROWSER_API_ENDPOINT=
PH_ETRAVEL_BROWSER_API_ENDPOINT=
JP_VJW_BROWSER_API_ENDPOINT=
KE_ETA_BROWSER_API_ENDPOINT=
JP_VJW_CDP_ENDPOINT=
KE_ETA_CDP_ENDPOINT=
JP_VJW_USER_AGENT=
JP_VJW_LIVE_ENABLED=false
JP_VJW_DELEGATED_OPERATION_APPROVED=false
KE_ETA_LIVE_ENABLED=false
JP_VJW_PLAYWRIGHT_HEADLESS=true
KE_ETA_PLAYWRIGHT_HEADLESS=true
# PH eTravel can be classified as a government site by generic Browser API
# zones. By default the runner ignores global Bright Data endpoints for PH and
# uses local Chrome/CDP or a PH-specific endpoint. Set this only after verifying
# the global endpoint is allowed for etravel.gov.ph.
PH_ETRAVEL_USE_GLOBAL_BROWSER_API=false
PH_ETRAVEL_CDP_ENDPOINT=
PH_ETRAVEL_ACCOUNT_EMAIL=
PH_ETRAVEL_ACCOUNT_PASSWORD=
PH_ETRAVEL_ACCOUNT_MPIN=
PH_ETRAVEL_EMAIL_VERIFICATION_TIMEOUT_MS=180000
# MDAC official portal currently blocks headless Chromium from this workstation.
# Leave unset for the runner default: local visible Google Chrome.
MDAC_PLAYWRIGHT_CHANNEL=chrome
MDAC_PLAYWRIGHT_HEADLESS=false
# TDAC is Cloudflare protected and defaults to Browserbase because Bright Data
# rejects this Thai government portal. TDAC_BROWSER_API_ENDPOINT is available
# only as an explicit CDP override when TDAC_BROWSERBASE_ENABLED=false.
TDAC_REQUIRE_BROWSER_API=
TDAC_PLAYWRIGHT_CHANNEL=chrome
TDAC_PLAYWRIGHT_HEADLESS=false
# Start local Chrome/CDP for PH with:
# npm run ph-etravel:chrome
PH_ETRAVEL_PLAYWRIGHT_CHANNEL=chrome
PH_ETRAVEL_PLAYWRIGHT_HEADLESS=false

# Taiwan NIA overseas-China entry permit. Keep disabled until an authorized
# controlled applicant session is ready; the runner will not send a code unless
# both this setting and its explicit sendVerificationCode option are true.
TW_ENTRY_PERMIT_EMAIL_VERIFICATION_ENABLED=false
TW_ENTRY_PERMIT_EMAIL_TIMEOUT_MS=180000
TW_ENTRY_PERMIT_CAPTCHA_TIMEOUT_MS=180000
TW_ENTRY_PERMIT_BROWSER_API_ENDPOINT=
TW_ENTRY_PERMIT_CDP_ENDPOINT=

# IMAP — shared inbox used by per-country runners to fetch verification
# / OTP emails from visa portals. Use a Gmail App Password (16-char,
# scoped, IMAP-only) — generate at https://myaccount.google.com/apppasswords.
# Never use the account's main password.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_EMAIL=your-throwaway@gmail.com
IMAP_PASSWORD=your-16-char-app-password

# Shared HMAC for signed runner results (must match agent-backend)
SUBMISSION_RESULT_SECRET_KEY=your-submission-result-hmac-key
READINESS_DB_TIMEOUT_MS=3000

# Ops alerting
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook
RESEND_OPS_ALERT_TO=ops@your-domain.com

# Public site URL (for links in e-visa retrieval emails)
NEXT_PUBLIC_SITE_URL=https://app.your-domain.com

# --- Per-country portal URLs (override built-in defaults; optional) ---
ID_PORTAL_URL=
EG_PORTAL_URL=
IN_PORTAL_URL=
LK_PORTAL_URL=
KH_PORTAL_URL=
LA_PORTAL_URL=
ZA_PORTAL_URL=
MY_PORTAL_URL=
TH_PORTAL_URL=
AE_PORTAL_URL=
TR_PORTAL_URL=
CA_PORTAL_URL=
AU_PORTAL_URL=
IT_VFS_CN_PORTAL_URL=

# --- Vietnam official-portal availability retries ---
# Retry only explicit pre-payment portal/network failures. Payment, final-submit,
# registration-code, 3DS/OTP, decline, and ambiguous gateway states never restart.
VN_PORTAL_MAX_ATTEMPTS=5
VN_PORTAL_RETRY_BACKOFF_MS=5000
VN_PORTAL_RETRY_MAX_BACKOFF_MS=60000

# Operator-only live smoke override. Never leave enabled after the authorized test run.
INDONESIA_DOCUMENT_PREFLIGHT_TEST_OVERRIDE=false
# Primary domain for newly minted applicant aliases.
INBOX_ALIAS_DOMAIN=viza.it.com
# Domains accepted by the legacy IMAP ingest path. Keep haggstorm.com while
# in-flight applications may still receive official mail at their old alias.
INBOX_ALIAS_DOMAINS=viza.it.com,haggstorm.com

# --- Recon / debug toggles (optional) ---
RECON_HEADFUL=false
DEBUG_RECON=false
VN_RECON_HEADFUL=false
CEAC_HEADLESS=true
CEAC_SKIP_TRANSLATION_GATE=false
# Browserbase cloud browser sessions (no project ID is required).
BROWSERBASE_API_KEY=
# Browserbase Free Plan validation defaults. The appointment smoke command
# forces one session at a time and disables managed proxies. Keep the country
# flags false outside an intentional smoke/deployment configuration.
BROWSERBASE_MAX_CONCURRENCY=1
US_APPOINTMENT_BROWSERBASE_ENABLED=false
US_APPOINTMENT_BROWSERBASE_PROXIES=false
US_APPOINTMENT_BROWSERBASE_VERIFIED=false
US_APPOINTMENT_BROWSERBASE_REGION=us-east-1
US_APPOINTMENT_BROWSERBASE_COUNTRY=US
FRANCE_TLS_BROWSERBASE_ENABLED=true
FRANCE_TLS_BROWSERBASE_PROXIES=true
FRANCE_TLS_BROWSERBASE_VERIFIED=false
FRANCE_TLS_BROWSERBASE_REGION=ap-southeast-1
FRANCE_TLS_BROWSERBASE_COUNTRY=CN
FRANCE_TLS_BROWSERBASE_TIMEOUT_SECONDS=300
FRANCE_TLS_BROWSERBASE_CAPTCHA_WAIT_MS=45000
FRANCE_TLS_ACTIVATION_LOOKBACK_DAYS=30
# Real account creation remains separately gated from Browserbase reachability.
FRANCE_TLS_ACCOUNT_REGISTRATION_ENABLED=false
# Separate operator/user authorization gate for an existing verified TLS
# account's official forgot-password flow. It never creates a second account.
FRANCE_TLS_ACCOUNT_PASSWORD_RESET_ENABLED=false
FRANCE_TLS_ACCOUNT_ABANDONMENT_ENABLED=false
# Enables authenticated TLScontact slot observation after alias activation.
FRANCE_TLS_LOCAL_OFFICIAL_SESSION_ENABLED=false
# Enables the exact user-selected slot handoff. The runner still pauses when
# TLScontact requires a secure payment session or returns no verifiable official
# confirmation number.
FRANCE_TLS_LIVE_BOOKING_ENABLED=false
FRANCE_TLS_EMAIL_TIMEOUT_MS=600000
# Shared only with agent-backend. Store the same random value in both Fly apps.
FRANCE_TLS_INTERNAL_TOKEN=
JP_VFS_SG_BROWSERBASE_ENABLED=false
JP_VFS_SG_BROWSERBASE_PROXIES=false
JP_VFS_SG_BROWSERBASE_REGION=ap-southeast-1
JP_VFS_SG_BROWSERBASE_COUNTRY=SG
JP_VFS_SG_LOCAL_OFFICIAL_SESSION_ENABLED=false
JP_VFS_SG_LIVE_BOOKING_ENABLED=false
JP_VFS_SG_BROWSER_API_ENDPOINT=
JP_VFS_SG_ARTIFACT_DIR=
# Shared only between agent-backend and submission-service for private cloud
# calls to /local/japan-vfs-sg/observe. Store as Fly secrets in both apps.
JP_VFS_SG_INTERNAL_TOKEN=
KR_SUBMISSION_INTERNAL_TOKEN=
# Optional authorized applicant preflight for appointment:free-smoke. Prefer
# passing --application-id at runtime; never commit a real application id.
APPOINTMENT_FREE_SMOKE_APPLICATION_ID=
APPOINTMENT_FREE_SMOKE_ARTIFACT_DIR=artifacts/appointment-free-smoke
MDAC_BROWSERBASE_ENABLED=false
MDAC_BROWSERBASE_PROXIES=true
MDAC_BROWSERBASE_REGION=ap-southeast-1
MDAC_BROWSERBASE_COUNTRY=MY

# Country runner Browserbase transport. These flags only replace Chromium
# launch/connection; they do not enable live submission, payment, or final-submit gates.
INDONESIA_BROWSERBASE_ENABLED=false
INDONESIA_BROWSERBASE_PROXIES=true
INDONESIA_BROWSERBASE_REGION=ap-southeast-1
INDONESIA_BROWSERBASE_COUNTRY=ID
# Dangerous compatibility escape hatch for the retired direct form-submit path.
# Keep false: the official step-1 AJAX save must persist passport data before step 2.
INDONESIA_STEP_1_USE_LEGACY_FALLBACKS=false
VN_BROWSERBASE_ENABLED=false
VN_BROWSERBASE_PROXIES=true
VN_BROWSERBASE_REGION=ap-southeast-1
VN_BROWSERBASE_COUNTRY=VN
SGAC_BROWSERBASE_ENABLED=false
SGAC_BROWSERBASE_PROXIES=true
SGAC_BROWSERBASE_REGION=ap-southeast-1
SGAC_BROWSERBASE_COUNTRY=SG
TDAC_BROWSERBASE_ENABLED=true
TDAC_BROWSERBASE_PROXIES=true
TDAC_BROWSERBASE_REGION=ap-southeast-1
TDAC_BROWSERBASE_COUNTRY=TH
KR_EAC_BROWSERBASE_ENABLED=true
KR_EAC_BROWSERBASE_PROXIES=true
KR_EAC_BROWSERBASE_REGION=ap-southeast-1
KR_EAC_BROWSERBASE_COUNTRY=KR
PH_ETRAVEL_BROWSERBASE_ENABLED=false
PH_ETRAVEL_BROWSERBASE_PROXIES=true
PH_ETRAVEL_BROWSERBASE_REGION=ap-southeast-1
PH_ETRAVEL_BROWSERBASE_COUNTRY=PH
CEAC_BROWSERBASE_ENABLED=false
CEAC_BROWSERBASE_PROXIES=true
CEAC_BROWSERBASE_REGION=us-east-1
CEAC_BROWSERBASE_COUNTRY=US
FRANCE_VISAS_BROWSERBASE_ENABLED=true
FRANCE_VISAS_BROWSERBASE_PROXIES=true
FRANCE_VISAS_BROWSERBASE_VERIFIED=false
FRANCE_VISAS_BROWSERBASE_REGION=eu-central-1
FRANCE_VISAS_BROWSERBASE_COUNTRY=FR
FRANCE_VISAS_BROWSERBASE_TIMEOUT_SECONDS=300


# Payment collection, card sessions, virtual card issuing, and official-fee autopay are removed.
