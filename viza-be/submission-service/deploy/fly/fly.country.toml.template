# Rendered by scripts/fly/deploy-country.sh. Do not put credentials here.
app = "__APP_NAME__"
primary_region = "__REGION__"

[env]
  NODE_ENV = "production"
  PORT = "8080"
  RUNNER_JOB_COUNTRY = "__COUNTRY__"
  SUBMISSION_SERVICE_LEGACY_QUEUE_ENABLED = "false"
  SUBMISSION_SERVICE_RUNNER_JOB_CONSUMER_ENABLED = "true"
  SUBMISSION_SERVICE_IDLE_EXIT_MS = "120000"
[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = true
  # Queue-depth autoscaling starts and stops the retained Machine. Fly Proxy
  # autostop is intentionally off because queue workers do not wake on HTTP.
  min_machines_running = 0

  [[http_service.checks]]
    grace_period = "30s"
    interval = "15s"
    method = "GET"
    timeout = "5s"
    path = "/ready"

[[restart]]
  policy = "on-failure"
  retries = 10

[[vm]]
  cpu_kind = "shared"
  cpus = 2
  memory_mb = 2048
