{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "viza-resilience-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "SUPABASE_URL": "https://oyjxdzsoejraedqghndi.supabase.co",
    "SUPABASE_PROJECT_REF": "oyjxdzsoejraedqghndi",
    "SUPABASE_MANAGEMENT_API_URL": "https://api.supabase.com",
    "VIZA_RESILIENCE_REPLAY_URL": "https://app.viza.it.com/api/resilience/replay",
    "VIZA_RESILIENCE_KEY_ID": "viza-web-v1",
    "WATCHDOG_AUTO_RESTART": "true",
    "WATCHDOG_CONFIRMATIONS": "3",
    "WATCHDOG_CONFIRMATION_INTERVAL_MS": "5000",
    "WATCHDOG_PROBE_TIMEOUT_MS": "4000",
    "WATCHDOG_RESTART_COOLDOWN_SECONDS": "1800",
    "WATCHDOG_RESTART_WINDOW_SECONDS": "3600",
    "WATCHDOG_MAX_RESTARTS_PER_WINDOW": "1",
    "WATCHDOG_RESTART_LEASE_SECONDS": "300",
    "WATCHDOG_REPLAY_BATCH_SIZE": "25",
    "WATCHDOG_REPLAY_LEASE_SECONDS": "120",
    "WATCHDOG_MAX_BODY_BYTES": "524288"
  },
  "queues": {
    "producers": [
      {
        "binding": "CRITICAL_NOTIFICATIONS_QUEUE",
        "queue": "viza-resilience-critical-notifications"
      },
      {
        "binding": "DOCUMENT_STATUS_QUEUE",
        "queue": "viza-resilience-document-status"
      },
      {
        "binding": "BACKGROUND_QUEUE",
        "queue": "viza-resilience-background"
      }
    ],
    "consumers": [
      {
        "queue": "viza-resilience-critical-notifications",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 10,
        "max_concurrency": 20,
        "retry_delay": 60
      },
      {
        "queue": "viza-resilience-document-status",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "max_concurrency": 10,
        "retry_delay": 60
      },
      {
        "queue": "viza-resilience-background",
        "max_batch_size": 10,
        "max_batch_timeout": 10,
        "max_retries": 10,
        "max_concurrency": 5,
        "retry_delay": 60
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RESILIENCE_STATE",
        "class_name": "ResilienceState"
      },
      {
        "name": "CONCURRENCY_GATE",
        "class_name": "ConcurrencyGate"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ResilienceState"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ConcurrencyGate"]
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
