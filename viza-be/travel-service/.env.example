# Required by itinerary.py
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_TIMEOUT_SECONDS=45

# Flight/Hotel API (RapidAPI Booking.com)
SERPAPI_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_BOOKING_HOST=
RAPIDAPI_BOOKING_BASE_URL=
RAPIDAPI_CONNECT_TIMEOUT_SECONDS=5
RAPIDAPI_READ_TIMEOUT_SECONDS=15
RAPIDAPI_WRITE_TIMEOUT_SECONDS=5
RAPIDAPI_POOL_TIMEOUT_SECONDS=5
RAPIDAPI_REQUEST_CONCURRENCY=8

# Per-request backpressure/deadlines (provider failures use deterministic fallbacks)
TRAVEL_SEARCH_CONCURRENCY=4
TRAVEL_SEARCH_DEADLINE_SECONDS=30
TRAVEL_OPENAI_ENDPOINT_DEADLINE_SECONDS=50

# Internal service auth. When set, every mutating route (/generate,
# /revise-itinerary, /chat, /download-word, /download-pdf, /flight-options,
# /hotel-options) requires an `x-internal-token` request header equal to this
# value. The Next.js proxy (viza-fe lib/travel/backend.ts) must send the same
# value. Leave unset for local dev (routes fail open with a startup warning).
TRAVEL_SERVICE_TOKEN=
# Comma-separated browser CORS allowlist. Defaults to the production portal +
# marketing origins when unset. Server-to-server proxy calls are unaffected.
TRAVEL_ALLOWED_ORIGINS=https://app.viza.it.com,https://viza.it.com
