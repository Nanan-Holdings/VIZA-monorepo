NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Independent Cloudflare resilience plane. The data key must be 32 random
# bytes encoded as base64; HMAC and data keys must be different secrets.
VIZA_RESILIENCE_GATEWAY_URL=
VIZA_RESILIENCE_HMAC_KEY_ID=viza-web-v1
VIZA_RESILIENCE_HMAC_SECRET=
VIZA_RESILIENCE_DATA_KEY=
# Domain used when assigning new per-applicant OTP inbox aliases.
INBOX_ALIAS_DOMAIN=viza.it.com
NEXT_PUBLIC_AGENT_BACKEND_URL=
NEXT_PUBLIC_FRANCE_SUBMISSION_MODE=dry_run
NEXT_PUBLIC_FRANCE_LIVE_SUBMISSION_ENABLED=false
NEXT_PUBLIC_DS160_SUBMISSION_MODE=dry_run
NEXT_PUBLIC_DS160_LIVE_ASSISTED_ENABLED=false
# Local submission-service health URL used by Vietnam one-time official-fee card sessions.
# Do not put PAN/CVV in env; users enter card details in the confirmation tab per payment.
SUBMISSION_SERVICE_LOCAL_URL=http://127.0.0.1:18080
# Compatibility URL used by Vietnam official-fee payment.
SUBMISSION_SERVICE_CLOUD_URL=
# Optional target-specific wake endpoints. When unset, the compatibility URL
# above is used; Vietnam, Singapore, Malaysia, and Thailand share the pool.
RUNNER_POOL_SUBMISSION_SERVICE_URL=
VIETNAM_SUBMISSION_SERVICE_URL=
# Dedicated sticky Indonesia runner. Do not point this at the legacy or pool app.
INDONESIA_SUBMISSION_SERVICE_URL=
SOUTH_KOREA_SUBMISSION_SERVICE_URL=
FLY_SUBMISSION_ORG_TOKEN=
FLY_RUNNER_POOL_APP=
FLY_SUBMISSION_LEGACY_APP=
FLY_RUNNER_INDONESIA_APP=
FLY_RUNNER_SOUTH_KOREA_APP=
# Server-only controlled-cutover switch. Set exactly `true` before draining
# runners; it blocks new runner/submission enqueues and every Queue/Fly wake.
RUNNER_CUTOVER_PAUSED=false
VIETNAM_CARD_SESSION_INTERNAL_TOKEN=
INDONESIA_CARD_SESSION_INTERNAL_TOKEN=
# Optional local-development relay override (defaults to https://app.viza.it.com).
# Keeps the Fly internal token out of the developer machine by forwarding the
# authenticated payment request to Vercel.
INDONESIA_OFFICIAL_FEE_RELAY_URL=
KR_EFORM_SUBMISSION_SERVICE_URL=
KR_KVAC_SUBMISSION_SERVICE_URL=
KR_SUBMISSION_INTERNAL_TOKEN=
TRAVEL_BACKEND_URL=http://127.0.0.1:8000
TRAVEL_GOOGLE_FALLBACK_ENABLED=true
GOOGLE_PLACES_API_ENABLED=true
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
OPENAI_FIELD_GUIDANCE_MODEL=gpt-5.5
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
PASSPORT_OCR_OPENAI_API_KEY=
# Optional outbound proxy for the server-side OCR provider call.
PASSPORT_OCR_PROXY_URL=
OPENAI_FORM_ASSISTANT_PROXY_URL=
FACE_MATCH_PROVIDER=openai_vision
FACE_MATCH_OPENAI_API_KEY=
FACE_MATCH_OPENAI_MODEL=gpt-4.1-mini
VN_FACE_MATCH_MIN_SCORE=0.7
# Public origin of THIS portal app. Magic-link sign-in redirects
# (provisionAccountAndMagicLink) are built from this — set it to the
# portal host in every env (prod: https://app.viza.it.com), not the
# marketing host.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Development-only client test session. Both flags must be true, and the
# endpoint also rejects every host except localhost/127.0.0.1. Use an existing
# applicant profile ID; this only bypasses the login screen, not Supabase data
# or Storage dependencies in the rest of the portal.
NEXT_PUBLIC_ENABLE_LOCAL_TEST_SESSION=false
ENABLE_LOCAL_TEST_SESSION=false
LOCAL_TEST_CLIENT_ID=
LOCAL_TEST_CLIENT_EMAIL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
# Optional override for the transactional From address (default
# "VIZA <welcome@viza.it.com>"). Set to a Resend-verified domain,
# e.g. "VIZA <welcome@viza.it.com>".
NOTIFY_FROM_EMAIL=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
AIRWALLEX_ENV=demo
AIRWALLEX_BASE_URL=https://api-demo.airwallex.com
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_LOGIN_AS=
AIRWALLEX_WEBHOOK_SECRET=
APP_BASE_URL=http://localhost:3000
TRANSLATION_PROVIDER=google
GOOGLE_TRANSLATE_API_VERSION=v2
GOOGLE_TRANSLATE_API_KEY=
TRANSLATION_MAX_CHARS_PER_REQUEST=5000

# Optional LiveTalking digital officer. The interview automatically falls back
# to the browser voice and static officer when this service is unavailable.
LIVETALKING_BASE_URL=http://127.0.0.1:8010
NEXT_PUBLIC_LIVETALKING_AVATAR_ID=wav2lip256_avatar1
NEXT_PUBLIC_LIVETALKING_VOICE=zh-CN-YunxiaNeural

# Contact-form intake (app/api/contact) — enquiries are emailed here.
# Falls back to NOTIFY_FROM_EMAIL when unset.
CONTACT_INBOX_EMAIL=

# --- PhotonPay (收单 / checkout gateway; replaces Stripe in card-checkout when enabled) ---
# When PHOTONPAY_ENABLED=true, app/actions/card-checkout.ts mints a PhotonPay
# hosted cashier session instead of Stripe. NOTE: production PhotonPay allowlists
# caller IPs, and Vercel has no static egress IP — in production this outbound
# call must run from the Render backend, not the Vercel function. The sandbox
# tenant lifted the allowlist for portal login on 2026-07-24; confirm whether the
# sandbox OPENAPI still enforces one before assuming local dev is unrestricted.
PHOTONPAY_ENABLED=false
# sandbox: https://x-api.sandbox.photontech.cc | production: https://x-api.photonpay.com
# (https://x-api1.uat.photontech.cc was decommissioned 2026-07-24)
PHOTONPAY_BASE_URL=https://x-api.sandbox.photontech.cc
PHOTONPAY_APP_ID=
PHOTONPAY_APP_SECRET=
# Merchant RSA private key (PKCS#8). Inline PEM (\n-escaped) for prod, or a file
# path for local dev. Upload the PUBLIC half in PhotonPay 商户后台 → 开发者.
PHOTONPAY_PRIVATE_KEY=
PHOTONPAY_PRIVATE_KEY_PATH=
# PhotonPay platform public key (开发者 → API Key → PhotonPay公钥) — verifies webhooks.
PHOTONPAY_PLATFORM_PUBLIC_KEY=
PHOTONPAY_PLATFORM_PUBLIC_KEY_PATH=
# Store id from 收单 → 站点管理 → 详情. Re-read this from the sandbox portal — the
# old UAT tenant's test site id (20260703922412081001) predates the 2026-07-24
# environment migration and is not assumed to carry over.
PHOTONPAY_SITE_ID=
# Public URL PhotonPay POSTs results to. Defaults to
# NEXT_PUBLIC_SITE_URL + /api/webhooks/photonpay; override for tunnels (ngrok) in dev.
PHOTONPAY_NOTIFY_URL=
